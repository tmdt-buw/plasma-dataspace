{
  "name": "plasma-ui",
  "version": "0.0.7",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "watch:common": "ng build common --watch",
    "watch:dms": "ng build modeling --watch",
    "watch:dss": "ng build data-sources --watch",
    "watch:sas": "ng build schema-analysis --watch",
    "clean": "rimraf dist",
    "build:common": "ng build common --configuration production",
    "build:dms": "ng build modeling --configuration production",
    "build:dss": "ng build data-sources --configuration production",
    "build:sas": "ng build schema-analysis --configuration production",
    "build": "ng build --configuration production",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "gen:dms": "npm run gen:base -- -o projects/modeling/src/lib/api/generated/dms -i http://localhost:8888/v3/api-docs/plasma-dms",
    "gen:dss": "npm run gen:base -- -o projects/data-sources/src/lib/api/generated -i http://localhost:8888/v3/api-docs/plasma-dss",
    "gen:kgs": "npm run gen:base -- -o projects/modeling/src/lib/api/generated/kgs -i http://localhost:8888/v3/api-docs/plasma-kgs",
    "gen:sas": "npm run gen:base -- -o projects/schema-analysis/src/lib/api/generated -i http://localhost:8888/v3/api-docs/plasma-sas",
    "gen:base": "openapi-generator-cli generate -g typescript-angular --additional-properties=providedInRoot=false,disallowAdditionalPropertiesIfNotPresent=false"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^12.2.16",
    "@angular/cdk": "^11.0.3",
    "@angular/common": "^12.2.16",
    "@angular/compiler": "^12.2.16",
    "@angular/core": "^12.2.16",
    "@angular/flex-layout": "^11.0.0-beta.33",
    "@angular/forms": "^12.2.16",
    "@angular/material": "^11.0.3",
    "@angular/platform-browser": "^12.2.16",
    "@angular/platform-browser-dynamic": "^12.2.16",
    "@angular/router": "^12.2.16",
    "classlist.js": "^1.1.20150312",
    "dagre": "^0.8.5",
    "graphlib": "^2.1.8",
    "jointjs": "^3.3.0",
    "ng-zorro-antd": "^12.1.1",
    "rxjs": "6.6.3",
    "svg-pan-zoom": "^3.6.1",
    "tslib": "^2.0.3",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^12.2.16",
    "@angular/cli": "^12.2.16",
    "@angular/compiler-cli": "^12.2.16",
    "@openapitools/openapi-generator-cli": "^2.1.16",
    "@types/backbone": "^1.4.5",
    "@types/dagre": "^0.7.44",
    "@types/jasmine": "~3.5.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/jquery": "^3.5.5",
    "@types/node": "^14.11.8",
    "codelyzer": "^6.0.1",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~6.0.0",
    "karma": "~6.3.17",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~4.0.1",
    "karma-jasmine-html-reporter": "^1.5.4",
    "ng-packagr": "^12.2.7",
    "protractor": "~7.0.0",
    "ts-node": "~9.0.0",
    "tslint": "~6.1.3",
    "typescript": "~4.3.5"
  }
}
