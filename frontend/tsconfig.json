{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "es2015",
    "module": "es2020",
    "lib": [
      "es2018",
      "dom"
    ],
    "paths": {
      "@data-platform/dss": [
        "dist/data-sources/data-sources",
        "dist/data-sources"
      ],
      "@data-platform/dms": [
        "dist/@data-platform/dms/@data-platform/dms",
        "dist/@data-platform/dms"
      ],
      "@data-platform/sas": [
        "dist/schema-analysis/schema-analysis",
        "dist/schema-analysis"
      ],
      "@data-platform/common": [
        "dist/common/common",
        "dist/common"
      ]
    }
  }
}
